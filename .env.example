# Database SQLite locale
DATABASE_URL="file:./dev.db"

# URL pubblico dell'app (per link e immagini di anteprima)
APP_URL="http://localhost:3000"

# Segreto per i cookie di sessione (genera con: openssl rand -base64 32)
AUTH_SECRET="cambia-questo-segreto-in-produzione"

# Claude (opzionale: senza chiave l'app gira in modalità demo)
ANTHROPIC_API_KEY=""
# Modelli (opzionali)
AI_MODEL_SMART="claude-sonnet-5-5"
AI_MODEL_FAST="claude-haiku-5-5"

# Google Places API (New) (opzionale: senza chiave si usa OpenStreetMap)
GOOGLE_PLACES_API_KEY=""

# Forza i dati dimostrativi nella ricerca lead (utile offline / in test)
LEADS_DEMO_MODE="false"

# Paesi per il geocoding (codici ISO separati da virgola; vuoto = tutto il mondo)
SEARCH_COUNTRYCODES="it"

# Crediti AI (opzionali): costo per azione e pacchetti "prezzoInCentesimi:crediti"
CREDIT_COST_SCORE="1"
CREDIT_COST_CHAT="2"
CREDIT_COST_BRIEFING="5"
CREDIT_PACKS="500:100,2000:500,5000:1500"

# Stripe Checkout per le ricariche (senza chiave i pagamenti risultano "non ancora attivi")
STRIPE_SECRET_KEY=""
# Webhook: https://<dominio>/api/stripe/webhook, evento checkout.session.completed
STRIPE_WEBHOOK_SECRET=""
