# Database SQLite locale
DATABASE_URL="file:./dev.db"

# Segreto per i cookie di sessione (genera con: openssl rand -base64 32)
AUTH_SECRET="cambia-questo-segreto-in-produzione"

# Claude (opzionale: senza chiave l'app gira in modalità demo)
ANTHROPIC_API_KEY=""
# Modelli (opzionali)
AI_MODEL_SMART="claude-opus-5-5"
AI_MODEL_FAST="claude-haiku-5-5"

# Google Places API (New) (opzionale: senza chiave si usa OpenStreetMap)
GOOGLE_PLACES_API_KEY=""

# Forza i dati dimostrativi nella ricerca lead (utile offline / in test)
LEADS_DEMO_MODE="false"

# Paesi per il geocoding (codici ISO separati da virgola; vuoto = tutto il mondo)
SEARCH_COUNTRYCODES="it"
